{
  "name": "duckoff-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/items.ts && tsx tests/random.ts && tsx tests/multiplayer.ts",
    "pretest": "spacetime publish --server http://127.0.0.1:3030 --module-path ../server/spacetimedb duckoff --delete-data=always -y"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spacetimedb": "2.9.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/drei": "^10.7.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0"
  }
}
